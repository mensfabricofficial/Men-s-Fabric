rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.uid == 'lw3mX9AivNduzBGundo3rB2jZcp2' ||
        request.auth.token.email == 'admin@mensfabric.com' ||
        request.auth.uid == 'HvhASQq3i8M7cFdrHRTC7f6hbuH3' ||
        request.auth.token.admin == true ||
        request.auth.token.email == 'mensfabricofficial@gmail.com' ||
        request.auth.token.email == 'me@admin.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Products Collection:
    // Fully readable by public; admin and checkout transactions can write/update/delete
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Categories Collection:
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // Banners Collection:
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if true;
    }

    // Site Settings Collection:
    match /settings/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Delivery Zones Collection:
    match /deliveryZones/{zoneId} {
      allow read: if true;
      allow write: if true;
    }

    // Coupons Collection:
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if true;
    }

    // Customer Profiles Collection (users):
    match /users/{userId} {
      allow read, write: if true;
    }

    // Customer Wishlists Collection:
    match /wishlists/{userId} {
      allow read, write: if true;
    }

    // Orders Collection:
    // Customers can place orders, view their orders, and admin can update status
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Product Reviews Collection:
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // Administrative Audit Logs:
    match /auditLogs/{logId} {
      allow read, write: if true;
    }

    // Administrators Registry:
    match /admins/{adminUid} {
      allow read, write: if true;
    }

    // Authorized Admin Devices Security Registry:
    match /adminAuthorizedDevices/{deviceId} {
      allow read, write: if true;
    }
  }
}
