rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.uid == 'HvhASQq3i8M7cFdrHRTC7f6hbuH3' ||
        request.auth.token.admin == true
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Products Collection:
    // - Public can read only active garments
    // - Administrator has full access
    // - Atomic checkout transactions may only decrement inventory
    match /products/{productId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalStock', 'variants', 'updatedAt']);
    }

    // Categories Collection:
    // - Public can read categories for navigation
    // - Administrator has full write permissions
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Banners Collection:
    // - Public can read active homepage banners
    // - Administrator has full write permissions
    match /banners/{bannerId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    // Site Settings Collection:
    // - Public can read general contact & announcement info
    // - Administrator has full write permissions
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Delivery Zones Collection:
    // - Public can read configured zones (Inside Dhaka / Outside Dhaka)
    // - Administrator has full write permissions
    match /deliveryZones/{zoneId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Coupons Collection:
    // - Public can read for code verification during checkout
    // - Transactions can only increment usedCount
    // - Administrator has full write permissions
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount', 'updatedAt']);
    }

    // Customer Profiles Collection (users):
    // - Customer can only read and manage their own profile
    // - Cannot grant themselves admin privileges or disable other users
    // - Administrator can read/manage all customer records
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
                    && (!('disabled' in request.resource.data) || request.resource.data.disabled == false)
                    && (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false);
      allow update: if isOwner(userId)
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['disabled', 'isAdmin']);
      allow write: if isAdmin();
    }

    // Customer Wishlists Collection:
    // - Authenticated customer can only read/write their own saved garments
    match /wishlists/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Orders Collection:
    // - Customers can create orders (must initialize with pending status and positive totals)
    // - Customers can only view their own orders
    // - Customers CANNOT modify or delete existing orders
    // - Only Administrator can update order status, payment status, or timeline
    match /orders/{orderId} {
      allow create: if request.resource.data.orderStatus == 'pending'
                    && request.resource.data.paymentStatus == 'pending'
                    && request.resource.data.total >= 0
                    && request.resource.data.subtotal >= 0
                    && request.resource.data.items.size() > 0;
      allow read: if (isAuthenticated() && resource.data.customerId == request.auth.uid) || isAdmin();
      allow update, delete: if isAdmin();
    }

    // Product Reviews Collection:
    // - Public can only read approved reviews
    // - Customers can submit reviews (initial approved status must be false)
    // - Only Administrator can approve, edit, or delete reviews
    match /reviews/{reviewId} {
      allow read: if resource.data.approved == true || isAdmin();
      allow create: if request.resource.data.approved == false
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;
      allow update, delete: if isAdmin();
    }

    // Administrative Audit Logs:
    // - Strictly restricted to authorized administrators
    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // Administrators Registry:
    // - Authenticated users can verify status; only super admin can modify
    match /admins/{adminUid} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
